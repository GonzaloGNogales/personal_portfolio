---
import { Image } from 'astro:assets'
import AdobeLogo from '@/assets/companies/adobe-official.svg'
import RobloxLogo from '@/assets/companies/roblox-official.svg'
import type { Internship } from '@/types/cv'

interface Props {
	internships: Internship[]
}

const { internships } = Astro.props
const logos = {
	adobe: AdobeLogo,
	roblox: RobloxLogo,
}
---

<h2 class='mb-3 text-3xl font-bold'>Internships</h2>
<p class='mb-8 max-w-2xl text-base-content/70'>
	Industry experience during my PhD.
</p>

<ol class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3'>
	{
		internships.map((internship) => (
			<li class='flex min-h-56 flex-col rounded-lg bg-base-200 p-6 text-base-content shadow-md transition-all duration-300 hover:bg-base-300 hover:shadow-lg'>
				<div class='mb-6 flex items-start justify-between gap-3'>
					<div class='flex h-14 w-[9.5rem] shrink-0 items-center'>
						<Image
							src={logos[internship.brand]}
							alt={`${internship.company} logo`}
							class:list={[
								'object-contain object-left',
								internship.brand === 'adobe' ? 'h-[3.25rem] w-auto' : 'h-auto w-[9.5rem]',
							]}
						/>
					</div>
					{
						internship.current && (
							<span class='rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700'>
								Current
							</span>
						)
					}
				</div>

				<h3 class='text-xl font-semibold'>{internship.title}</h3>
				<p class='mt-1 text-sm font-medium text-base-content/60'>{internship.office}</p>

				<div class='mt-auto space-y-3 pt-6 text-sm text-base-content/75'>
					<p class='flex items-start gap-2'>
						<svg class='mt-0.5 h-4 w-4 shrink-0' aria-hidden='true' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
							<path stroke-linecap='round' stroke-linejoin='round' d='M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z' />
						</svg>
						{internship.time}
					</p>
					<p class='flex items-start gap-2'>
						<svg class='mt-0.5 h-4 w-4 shrink-0' aria-hidden='true' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
							<path stroke-linecap='round' stroke-linejoin='round' d='M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z' />
							<circle cx='12' cy='10' r='2.5' />
						</svg>
						{internship.location}
					</p>
				</div>
			</li>
		))
	}
</ol>
