---
import PublicationCard from './PublicationCard.astro'
import type { Publication } from '@/lib/publications'

interface Props {
	elements: Publication[]
}

const { elements } = Astro.props
---

<ol class='divide-y divide-base-300'>
	{
		elements.map((publication) => (
			<li>
				<PublicationCard publication={publication} compact={true} />
			</li>
		))
	}
</ol>
