---
import PublicationCard from './PublicationCard.astro'
import type { Publication } from '@/lib/publications'

interface Props {
	listTitle: string
	listItems: Publication[]
	showAbstract?: boolean
	headingLevel?: 'h1' | 'h2'
}

const {
	listTitle,
	listItems,
	showAbstract = false,
	headingLevel = 'h2',
} = Astro.props
const Heading = headingLevel
---

<Heading class='mb-8 text-3xl font-bold'>{listTitle}</Heading>
<ol class='space-y-5 sm:space-y-6'>
	{
		listItems.map((publication) => (
			<li>
				<PublicationCard publication={publication} showAbstract={showAbstract} />
			</li>
		))
	}
</ol>
