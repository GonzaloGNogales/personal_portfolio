---
import { Image } from 'astro:assets';
import SocialIcons from './SocialIcons.astro';

const { fullName, title, institute, profilePicture } = Astro.props;
---

<section class="flex flex-col-reverse items-start gap-8 py-10 sm:py-12 md:flex-row md:items-center lg:gap-12 lg:py-16">
  <div class="flex-1 min-w-0 text-center md:text-left">
    <h1 class="mb-4 text-3xl font-bold leading-tight sm:text-4xl">
      Hola! I'm <span class="text-turquoise">{fullName}</span>
    </h1>
    {(title || institute) && (
      <p class="mb-4 text-lg text-gray-600 sm:text-xl">
        {title}{institute ? ' at ' + institute : ''}
      </p>
    )}

    <p class="mb-6 break-words text-left text-base leading-relaxed sm:text-lg">
      I am a third-year PhD student under the supervision of
      <a href="https://dancasas.github.io/" class="university-link" target="_blank" rel="noopener noreferrer"><b>Prof. Dr. Dan Casas</b></a>
      and
      <a href="https://scholar.google.com/citations?user=5b5lpdjyjg0C&hl=es" class="university-link" target="_blank" rel="noopener noreferrer"><b>Prof. Dr. Marc Comino-Trinidad</b></a>
      at
      <a href="https://mslab.es/" class="university-link" target="_blank" rel="noopener noreferrer"><b>Universidad Rey Juan Carlos (MSLab)</b></a>
      in Madrid, Spain. My research interests lie at the intersection of <b>Computer Graphics</b>, <b>Physics Simulation</b> and <b>Machine Learning</b>, with a particular focus on developing novel ways of enhancing 3D Graphics realism, control and interactivity with AI.
    </p>

    <p class="mb-6 break-words text-left text-base leading-relaxed sm:text-lg">
      I completed two research internships at
      <a href="https://research.adobe.com/" class="university-link" target="_blank" rel="noopener noreferrer"><b>Adobe Research</b></a>.
      In <b>2024</b>, I joined the
      <a href="https://research.adobe.com/careers/paris/" class="university-link" target="_blank" rel="noopener noreferrer"><b>Paris</b></a>
      office for a <b>six-month internship</b>, where I worked with Drs.
      <a href="https://elenagarces.es/" class="university-link" target="_blank" rel="noopener noreferrer">Elena Garcés</a>,
      <a href="https://dannykaufman.io/" class="university-link" target="_blank" rel="noopener noreferrer">Danny M. Kaufman</a>,
      <a href="https://zhenchen-jay.github.io/" class="university-link" target="_blank" rel="noopener noreferrer">Zhen Chen</a> and
      <a href="https://research.adobe.com/person/rosalie-martin/" class="university-link" target="_blank" rel="noopener noreferrer">Rosalie Martin</a>.
      In <b>2025</b>, I completed a <b>summer internship</b> at the
      <a href="https://research.adobe.com/careers/san-jose/" class="university-link" target="_blank" rel="noopener noreferrer"><b>San Jose</b></a>
      office, working with Drs.
      <a href="https://zhouyisjtu.github.io/" class="university-link" target="_blank" rel="noopener noreferrer">Yi Zhou</a>,
      <a href="https://yiconghong.me/" class="university-link" target="_blank" rel="noopener noreferrer">Yicong Hong</a> and
      <a href="https://chongjiange.github.io/" class="university-link" target="_blank" rel="noopener noreferrer">Chongjian Ge</a>.
    </p>

    <p class="mb-6 break-words text-left text-base leading-relaxed sm:text-lg">
      I am dedicated and enthusiastic, with a constant desire to grow and learn from every experience and person around me. Passionate about computer graphics and research, I strive to push my own limits and continuously improve.
    </p>

    <div class="flex justify-center md:justify-start gap-4">
      <SocialIcons />
    </div>
  </div>

  <div class="flex w-full justify-center md:hidden">
    <Image src={profilePicture} alt={fullName} class="rounded-lg object-cover w-48 h-48 sm:w-64 sm:h-64 max-w-full" />
  </div>

  <div class="hidden flex-none self-center justify-center md:flex">
    <Image src={profilePicture} alt={fullName} class="rounded-lg object-cover w-80 h-96 max-w-full" />
  </div>
</section>

<style>
  .text-turquoise {
    color: #40E0D0;
  }

  section p {
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .university-link {
    color: #d97706;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
  }

  .university-link:hover {
    color: #f59e0b;
    border-bottom-color: #f59e0b;
    text-shadow: 0 0 8px rgba(217, 119, 6, 0.3);
  }
</style>
