---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import { getPublications } from '@/lib/publications'
import ProfilePictures from '@/assets/profile_photo.jpeg'
import Hero from '@/components/ui/Hero.astro'
import Grid from '@/components/ui/Grid.astro'
import ArticleList from '@/components/ui/ArticleList.astro'

const { fullName, title, institute, research_areas } = profile
const publications = await getPublications()
---

<Layout>
	<Hero
		fullName={fullName}
		title={title}
		institute={institute}
		profilePicture={ProfilePictures}
	/>

	<section class='border-y py-10 sm:py-12'>
		<Grid gridTitle='Research Areas' gridItems={research_areas} />
	</section>

	<section id='publications' class='py-10 sm:py-12'>
		<ArticleList listTitle='Publications' listItems={publications} />
	</section>
</Layout>
